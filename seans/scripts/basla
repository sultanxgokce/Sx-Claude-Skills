#!/usr/bin/env bash
# basla — kutuda terminal açılınca gelen KARŞILAMA EKRANI.
#
# NİÇİN VAR (2026-07-30, Sultan): terminal açılır açılmaz `cs` seans-seçici geliyordu.
# "Kafa karışıyor; yenisession yazması gerektiğini kimse bilmiyor." Seans listesi, ne
# yapacağını ZATEN bilen birine göre bir ekran — yeni gelen için değil.
#
# v2 (Sultan geri-bildirimi, aynı gün):
#   · "seçim yaptıktan sonra geriye dönmek yok"      → her eylemden sonra menüye DÖNER
#   · "2'yi seçince karmaşık bir cümbüşe düşüyorum"  → ekip ÜSTTE sabit; 103-satırlık
#      filo listesi menüden kalktı, yalnız 'ara' seçeneğinin arkasında
#   · "ekip demirbaş, üstte sabit olmalı"            → Ekibim bloğu roster'dan gelir
#   · "tek tuşla kontrol: ayakta mı, duplike var mı" → seçenek 1 (ölç → göster → onar-öner)
#   · kutu adı artık SABİT DEĞİL — roster/dizinden türetilir ("Huzur" her kutuda yazıyordu)
#
# Sözleşme: hiçbir şey ZORLAMAZ. Enter → düz terminal. TTY yoksa yalnız yazar ve çıkar.
# ÖLÇÜM ≠ İDDİA: ekip satırı ekip-durum.sh'ten gelir; ölçülemezse "ölçülemedi" der,
# "her şey yolunda" DEMEZ.
set -u

# ⚠️ SYMLINK-FARKINDA yol çözümü. Bu betik PATH'ten (~/.local/bin/basla → symlink) çağrılır;
# çıplak dirname o zaman /config/.local/bin verir ve yanındaki ekip-durum.sh'i BULAMAZ
# (firsthand 2026-07-30: ekran "ölçülemedi" dedi, oysa ölçüm betiği tek başına çalışıyordu).
# Doğrudan koşumda test edip PATH koşumunda kırılan sınıf — "birim yeşil ≠ yol çalışıyor".
_KAYNAK="${BASH_SOURCE[0]}"
while [ -L "$_KAYNAK" ]; do
  _HEDEF="$(readlink "$_KAYNAK")"
  case "$_HEDEF" in /*) _KAYNAK="$_HEDEF" ;; *) _KAYNAK="$(dirname "$_KAYNAK")/$_HEDEF" ;; esac
done
HERE=$(cd "$(dirname "$_KAYNAK")" && pwd)
PROJE="${BASLA_PROJE:-$(basename "${PWD:-/}")}"
[ "$PROJE" = "/" ] && PROJE="çalışma alanı"
EKIP_YOK=0
PANO="${BASLA_PANO:-}"
KILAVUZ="${BASLA_KILAVUZ:-}"

if [ -t 1 ]; then
  C_BAS=$'\033[1m'; C_SOL=$'\033[2m'; C_VUR=$'\033[36m'; C_YSL=$'\033[32m'; C_KRM=$'\033[31m'; C_SAR=$'\033[33m'; C_SIF=$'\033[0m'
else
  C_BAS=""; C_SOL=""; C_VUR=""; C_YSL=""; C_KRM=""; C_SAR=""; C_SIF=""
fi

# ── OK-TUŞLU SEÇİCİ ──────────────────────────────────────────────────────────
# NİÇİN (Sultan, 2026-07-30 canlı test): çıplak `read` ok-tuşlarını harf sanıyor ve ekrana
# `^[[B^[[A` basıyordu ("saçma saçma karakterler"). fzf bu kutuda ZATEN kurulu ve `cs` de
# onu kullanıyor — yeni bağımlılık yok, tutarlı davranış var.
# Sözleşme: fzf varsa ok+Enter (yazarak da süzülür); yoksa numara-okuma yedeği.
# Çıktı: seçilen satırın İLK jetonu (menü numarası ya da üye sırası). ESC/iptal → boş.
_sec() {  # _sec "<baslik>" <satir...>
  local baslik="$1"; shift
  if [ -n "${BASLA_TEST_SECIM:-}" ]; then
    # Sınama-dikişi: test modunda liste EKRANA çizilmez (fzf koşmaz) → listenin İÇERİĞİ
    # ve SIRASI hiçbir kapıdan görünmezdi. BASLA_TEST_LISTE=1 iken adayları stderr'e
    # basar; bayrak set edilmedikçe davranış hiç değişmez.
    [ -n "${BASLA_TEST_LISTE:-}" ] && printf 'ADAY: %s\n' "$@" >&2
    printf '%s\n' "${BASLA_TEST_UYE:-}"; return 0
  fi
  # ⚠️ `[ -t 1 ]` KULLANMA: _sec her zaman $(...) içinde çağrılır, orada stdout BİR BORUDUR,
  # terminal değil → kapı hep kapalı kalır, fzf hiç açılmaz ve yedek yol menüyü DEĞİŞKENE yazar
  # (kullanıcı hiçbir şey görmez, okları read'e gider → ekrana ^[[B basar).
  # Firsthand: Sultan 2026-07-30, iki ayrı ekran görüntüsü. Doğru kapı: /dev/tty erişilebilir mi.
  if command -v fzf >/dev/null 2>&1 && [ -r /dev/tty ] && [ -w /dev/tty ]; then
    printf '%s\n' "$@" | fzf --ansi --no-multi --height=~60% --reverse --border=none \
        --prompt='› ' --header="$baslik" --info=inline \
        --bind='esc:abort' | awk '{print $1}'
    # NOT: fzf'e `< /dev/tty` VERİLMEZ — stdin aday-listesidir (boru). /dev/tty'ye yönlendirmek
    # listeyi EZER ve fzf boş listeyle açılır. Klavyeyi fzf kendisi /dev/tty'den okur.
    return 0
  fi
  # yedek: numara-okuma. UI /dev/tty'ye yazılır (stdout DÖNÜŞ-DEĞERİdir, kirletilemez).
  if [ -w /dev/tty ]; then
    printf '%s\n' "$@"        > /dev/tty
    printf '\n  Seçimin (numara): ' > /dev/tty
    local s; read -r s < /dev/tty || s=""
    printf '\n' > /dev/tty
    printf '%s\n' "$s" | awk '{print $1}'
  else
    # ne fzf ne tty → seçim sorulamaz (betik/otomasyon): boş dön, çağıran çıkar.
    printf '\n'
  fi
}

_ekip_blogu() {
  local out rc
  out="$(bash "$HERE/ekip-durum.sh" 2>/dev/null)"; rc=$?
  # ⚠️ İKİ AYRI ARIZA, İKİ AYRI CÜMLE (Sultan tez kutusunda canlı gördü, 2026-07-30):
  #   rc=3 → ekip listesi dosyası YOK        → "bu dizinde ekip tanımı yok" DOĞRU
  #   rc=2 → dosya VAR ama ÖLÇEMEDİM (araç eksik: python3/tmux/bozuk-yaml)
  # Eski hâl ikisini aynı cümleye yıkıyordu → dosya dururken "ekip yok" YALANI basılıyordu.
  if [ "$rc" -eq 2 ] && [ -n "$out" ]; then
    local jeton; jeton="$(printf '%s' "$out" | head -1 | cut -f1)"
    local sebep
    case "$jeton" in
      PYTHON-YOK) sebep="python3 bu kutuda yok" ;;
      TMUX-YOK)   sebep="tmux bu kutuda yok" ;;
      OKUNAMADI)  sebep="ekip listesi okunamadı (biçim bozuk olabilir)" ;;
      *)          sebep="$jeton" ;;
    esac
    printf '  %sEkibim%s\n' "$C_BAS" "$C_SIF"
    printf '  %sölçemedim%s — %s\n' "$C_SAR" "$C_SIF" "$sebep"
    printf '  %s(ekip listesi VAR; eksik olan ölçüm aracı — "ekip yok" demek yanlış olurdu)%s\n\n' \
           "$C_SOL" "$C_SIF"
    EKIP_YOK=1
    return 0
  fi
  if [ "$rc" -ne 0 ] || [ -z "$out" ]; then
    printf '  %sEkibim%s\n' "$C_BAS" "$C_SIF"
    printf '  %sbu dizinde ekip tanımı yok%s\n' "$C_SOL" "$C_SIF"
    # Yol göster: hangi alt dizinlerde ekip tanımı VAR? (üst dizinde durunca en sık hâl)
    local bulunan="" d
    for d in */ ; do
      [ -d "$d" ] || continue
      if [ -f "${d}_agents/handoff/aile-registry.yaml" ] || [ -f "${d}_agents/ekip-os/ekip-registry.yaml" ] \
         || [ -f "${d}_agents/handoff/ekip-registry.yaml" ]; then
        bulunan="$bulunan ${d%/}"
      fi
    done
    if [ -n "$bulunan" ]; then
      printf '  %sekip tanımı olan projeler:%s%s\n' "$C_SOL" "$bulunan" "$C_SIF"
      printf '  %sör:  cd %s && basla%s\n\n' "$C_SOL" "$(printf '%s' "$bulunan" | awk '{print $1}')" "$C_SIF"
    else
      printf '  %s(tek kişilik kutu olabilir — bu bir arıza değil)%s\n\n' "$C_SOL" "$C_SIF"
    fi
    EKIP_YOK=1
    return 0
  fi
  local ozet; ozet="$(printf '%s\n' "$out" | awk -F'\t' '$1=="ÖZET"{print $2" "$3" "$4}')"
  set -- $ozet; local a="${1:-0}" k="${2:-0}" d="${3:-0}"
  printf '  %sEkibim%s  %s(demirbaş — sabit)%s\n' "$C_BAS" "$C_SIF" "$C_SOL" "$C_SIF"
  printf '%s\n' "$out" | awk -F'\t' -v ys="$C_YSL" -v sr="$C_SAR" -v sf="$C_SIF" -v sl="$C_SOL" '
    # gorunur-genislik: UTF-8 devam-baytlari (0x80-0xBF) sayilmaz — Turkce harfler sutunu kaydirmasin
    function gw(s){ t=s; gsub(/[\200-\277]/,"",t); return length(t) }
    function pad(s,w){ n=w-gw(s); r=""; while(n-->0) r=r" "; return s r }
    $1=="ÖZET" || $1=="" {next}
    {
      ad=pad($1,15);
      if ($3=="ayakta")       printf "   %s●%s %s %sayakta%s\n",  ys, sf, ad, ys, sf;
      else if ($3=="duplike") printf "   %s⚠%s %s %s%s%s\n",      sr, sf, ad, sr, $4, sf;
      else                    printf "   %s○%s %s %skapalı%s\n",  sl, sf, ad, sl, sf;
    }'
  printf '\n   %s%s ayakta · %s kapalı%s' "$C_SOL" "$a" "$k" "$C_SIF"
  [ "$d" -gt 0 ] && printf '%s · %s duplike%s' "$C_SAR" "$d" "$C_SIF"
  printf '\n'
  printf '   %smasa ≠ sohbet: masa açık olsa da içinde Claude çalışmıyor olabilir%s\n\n' "$C_SOL" "$C_SIF"
}

# _kopya_satiri — "hangi çalışma kopyasındayım, kaç masayla paylaşıyorum" tek satırı.
#
# NİÇİN (2026-07-30, firsthand ölçüm · huzur): üç masa TEK kopyayı paylaşıyordu ve bunu
# EKRANDA HİÇBİR YER SÖYLEMİYORDU — biri dal değiştirince ötekinin kaydedilmemiş işi
# taşınır, kimse haber vermez. Görünmeyen paylaşım, sessiz kayıptır. Bu satır onu görünür
# kılar; çözümü `kendi-kopyam` yapar (ekran hiçbir şeyi kendiliğinden değiştirmez).
#
# ⚠️ MENÜ NUMARALARINA DOKUNULMADI: bu bilgi satırıdır, seçenek DEĞİL. Numaralar ekibe
# yazılı olarak bildirildi (1 kontrol · 2 masaya geç · 3 yeni sohbet · 4 kurallar · 5 ara);
# araya seçenek sokmak o yönergeyi sessizce yanlışlar.
#
# ⚠️ ÖLÇÜMÜ BURADA TEKRARLAMIYORUZ. Aynı gerçeği iki ayrı yerde hesaplamak, birini
# düzeltip ötekini bayat bırakma sınıfının kaynağıdır (bugün üç kez yaşandı). Tek
# otorite `kendi-kopyam --satir`; bu ekran onu ÇAĞIRIR. Araç yoksa sessiz kalır —
# eski davranış birebir korunur, ekran kırılmaz.
_kopya_satiri() {
  local arac="$HERE/kendi-kopyam"
  [ -x "$arac" ] || arac="$(command -v kendi-kopyam 2>/dev/null)"
  [ -n "$arac" ] && [ -x "$arac" ] || return 0
  "$arac" --satir 2>/dev/null || true
}

# _yapistirma_nabzi — resim-yapıştırma dinleyicisi (127.0.0.1:8391) yaşıyor mu?
#
# NİÇİN BURADA (firsthand 2026-07-30): Sultan Cmd+V ile pano-resmi yapıştırınca "HTTP 500"
# aldı. Ölçüm: 13 kutunun 11'inde dinleyici sağlıklı, 2'sinde (tez · huzur) ÖLÜ. Dinleyici bir
# tmux masasında yaşıyor; konteyner recreate/restart o masayı öldürüyor ve onu geri getiren
# hiçbir şey yok. (tez'i o gün recreate etmiştim — ölüm tam o an.)
# Bu ekran artık HER YENİ TERMİNALDE koşuyor, yani Sultan yapıştırmadan hemen önce: nabzı
# kontrol etmenin en doğru yeri burası. Kurulumu YENİDEN YAZMAZ — kutunun kendi başlatıcısını
# çağırır (tek kaynak). Sağlıklıysa TEK KELİME etmez; sustuğu yer "her şey yolunda"dır.
# _kapimda_blogu — Sultan'ı bekleyen kartları karşılama ekranında göster (L38 F1).
#
# NİÇİN BURADA (firsthand 2026-07-31): `kapimda.md` aynı gün kuruldu ama
# `grep -rl kapimda skills/ cloudtop/scripts/` → **0 eşleşme**. Yani "işler kaybolmasın"
# diye açılan dosyanın kendisi kaybolmaya adaydı: Sultan elle açmadıkça hiçbir yer
# göstermiyordu — filonun kronik "yapılmış ama bağlanmamış iş" hastalığı, kurulduğu gün.
# Bu ekran her yeni terminalde koşuyor → kartların görüneceği en doğru yer burası.
#
# DAVRANIŞ: dosya yoksa ya da kart yoksa **tek kelime etmez** (yokluk ≠ arıza).
# Tavan 3 kart (L38 §4.1); fazlası tek satır "+N daha" olarak sayılır — ekran şişmez.
# Yalnız BAŞLIK basar: gövde/adım/komut ekrana dökülmez, detay dosyada kalır.
_kapimda_blogu() {
  local dosya="${KAPIMDA_DOSYA:-$HOME/.claude/kapimda.md}"
  [ -r "$dosya" ] || return 0
  local -a kartlar=()
  # Kart başlığı: "🚦 SENDE · <Kısa Ad>". `⏸️ BAŞKASINDA` bilinçli olarak SAYILMAZ —
  # o iş Sultan'da değil; kapıda göstermek yanlış-yük olur.
  mapfile -t kartlar < <(grep -oP '^🚦 SENDE · \K.*' "$dosya" 2>/dev/null)
  local n=${#kartlar[@]}
  [ "$n" -gt 0 ] || return 0
  printf '\n  %s🚦 kapında %s iş var%s\n' "$C_SAR" "$n" "$C_SIF"
  local i=0
  for k in "${kartlar[@]}"; do
    i=$((i+1)); [ "$i" -le 3 ] || break
    printf '     • %s\n' "$k"
  done
  [ "$n" -gt 3 ] && printf '     %s+%s daha%s\n' "$C_SOL" "$((n-3))" "$C_SIF"
  printf '     %sdetay: %s%s\n' "$C_SOL" "$dosya" "$C_SIF"
}

# _talep_zili — başka odalardan gelen, HENÜZ SAHİPSİZ taleplerin zili (L37-F2).
#
# NİÇİN VAR: odalar arası talepler bir kuyruğa düşüyor ama kuyruğu kimse görmüyordu.
# Ölçüm: 7 talep 8 gün 20 saat sahipsiz bekledi; kuyruk "temiz" görünüyordu çünkü
# teslimat ile üstlenme aynı damgaya bağlıydı (L37-F0 onu ayırdı). Bu zil, ayrılan
# gerçeği ekrana taşır: "bekleyen var ve KİMSE üstlenmemiş".
#
# 🔴 AĞA ÇIKMAZ. Ölçümü 15 dakikada bir koşan cron yapar ve `durum.txt`'ye yazar; bu
# fonksiyon yalnız o dosyayı okur. Sebep: `basla` her yeni terminalde koşuyor — buraya
# API çağrısı koymak açılışı ağ gecikmesine ve token varlığına bağlardı, token'sız
# kutuda da ekran "0 bekliyor" diyerek SAHTE-YEŞİL üretirdi.
# Ölçüm bayatsa (>2 saat) sayı basılmaz, "doğrulanmadı" denir — kırmızı DEĞİL, dürüst.
_talep_zili() {
  local d="${FEDERE_DURUM:-/config/.federe/durum.txt}"
  [ -r "$d" ] || return 0                      # ölçüm hiç yapılmamış → sessiz (yokluk ≠ arıza)
  local adet en_eski kontrol kapsam
  adet="$(sed -n 's/^adet=//p' "$d" | head -1)"
  en_eski="$(sed -n 's/^en_eski=//p' "$d" | head -1)"
  kontrol="$(sed -n 's/^kontrol=//p' "$d" | head -1)"
  kapsam="$(sed -n 's/^kapsam=//p' "$d" | head -1)"
  case "${adet:-}" in ''|*[!0-9]*) return 0 ;; esac
  [ "$adet" -gt 0 ] || return 0                # kuyruk boş → tek kelime etme

  # Ölçüm tazeliği: cron 15 dk'da bir koşar. 2 saati aşan ölçüm güvenilmez sayılır
  # (cron durmuş olabilir) → sayıyı GERÇEK gibi sunmak yanlış olur.
  local simdi_s kontrol_s yas_dk=""
  if [ -n "$kontrol" ]; then
    simdi_s="$(date -u +%s 2>/dev/null)"
    kontrol_s="$(date -u -d "$(printf '%s' "$kontrol" | sed 's/Z$//')" +%s 2>/dev/null || echo "")"
    [ -n "$kontrol_s" ] && [ -n "$simdi_s" ] && yas_dk=$(( (simdi_s - kontrol_s) / 60 ))
  fi
  if [ -n "$yas_dk" ] && [ "$yas_dk" -gt 120 ]; then
    printf '\n  %s📮 oda-talepleri: doğrulanmadı%s — son ölçüm %s dk önce (dinleyici durmuş olabilir)\n' \
           "$C_SOL" "$C_SIF" "$yas_dk"
    return 0
  fi

  # En eski bekleyenin yaşı — "8 gündür duruyor" cümlesini kuran şey bu.
  local bekleme=""
  if [ -n "$en_eski" ] && [ "$en_eski" != "-" ]; then
    local es_s; es_s="$(date -u -d "$(printf '%s' "$en_eski" | sed 's/Z$//')" +%s 2>/dev/null || echo "")"
    if [ -n "$es_s" ] && [ -n "${simdi_s:-}" ]; then
      local saat=$(( (simdi_s - es_s) / 3600 ))
      if   [ "$saat" -ge 48 ]; then bekleme=" · en eskisi $(( saat / 24 )) gündür bekliyor"
      elif [ "$saat" -ge 1 ];  then bekleme=" · en eskisi $saat saattir bekliyor"
      fi
    fi
  fi
  printf '\n  %sBU KUTUNUN gelen kutusu: 📮 %s oda-talebi SAHİPSİZ%s%s\n' "$C_SAR" "$adet" "$C_SIF" "$bekleme"
  printf '     %süstlenmek için: federe.sh alindi <id> · listelemek için: federe.sh gelen bekliyor%s\n' \
         "$C_SOL" "$C_SIF"
  # Kapsam damgası (L50): sayı merkezden ölçülür ve token cell-izolasyonludur → yalnız
  # merkez-kaynaklı bekleyenleri kapsar. Bunu söylemezsek okuyan sayıyı "kuyruğun tamamı"
  # sanar; oda-odaya gelen bir mesaj görünmediğinde ekran farkında olmadan yalan söylemiş olur.
  [ "${kapsam:-}" = "s01-kaynakli" ] && \
    printf '     %s(sayım merkez-kaynaklı mesajları kapsar — oda-odaya gelenler ayrıca: federe.sh gelen)%s\n' \
           "$C_SOL" "$C_SIF"
  return 0
}

# _kuyruk_satiri — bu kutunun ANA-HEDEF kuyruğu: "durmak yok" kuralının EKRAN YÜZÜ (MABEYN H4-2).
#
# NİÇİN VAR (ölçülmüş 2026-08-04): durma-standardı "Ş2-fiili ya da eskalasyon-sinyali yoksa
# DURMAK ihlaldir" der — ama ajan kendi kuyruğunu görmüyorsa kural boşlukta kalır. Aynı gün
# plan-bekçisi 12/12 kutuyu PLANSIZ ölçtü; sebep tembellik değil, çapanın hiç dağıtılmamış
# olmasıydı. Çapa artık dağıtıldı; bu satır onu HER YENİ TERMİNALDE görünür kılar — yoksa
# dosya yine "yapılmış ama bağlanmamış iş" olurdu (kapımda bloğunun birebir dersi).
#
# ÜÇ HÂL (hepsi dürüst, hiçbiri sahte-yeşil):
#   çapa YOK      → "hedefin yazılı değil" + şablonun yeri (dağıtım paketinden gelir)
#   kuyruk DOLU   → sıradaki iş + "Ş2 yoksa sor-durma, yürü"
#   kuyruk BOŞ    → "MÜDÜR'e kuyruk-boş bildir" — Sultan'a DEĞİL (kesme-enflasyonu panzehiri)
# Damga >7 gün ise ayrıca "bayat" der (tazelik MÜDÜR sorumluluğu).
# İ1: kutunun KENDİ dosyası, kendi ekranı — hiçbir şey dışarı taşınmaz. Yalnız İLK iş basılır.
_kuyruk_satiri() {
  local d="${ANA_HEDEF_DOSYA:-}"
  if [ -z "$d" ]; then
    # 🔴 İLK CANLI KOŞUM DERSİ (2026-08-04): önce `ls /config/projects/*/…| head -1` yazılmıştı.
    # İzole kutuda tek repo var, doğru çalışıyordu; MERKEZ kutuda onlarca repo var ve alfabetik
    # ilk sırayı aldı → BAŞKA kutunun hedefi ekrana geldi (yanlış bilgi + İ1'e yakın sızıntı).
    # Doğru kaynak: İÇİNDE BULUNDUĞUN deponun çapası. Bulunamazsa ve aday BİRDEN ÇOKSA
    # tahmin YAPILMAZ — sessiz kalınır (yanlış söylemek, susmaktan kötüdür).
    # 🔴 İKİNCİ DERS (aynı gün, ikinci canlı koşum): "git-kökü yoksa tek-aday varsa onu al"
    # yedeği de yanlış çıktı — bir depodaYDIK (Nexus), ama onun çapası yerel checkout'ta
    # yoktu; yedek devreye girip KOMŞU deponun (MMEx) hedefini seçti. Doğru kural sert:
    # bir depodaysan YALNIZ o deponun çapası; yoksa SUS. Tarama yedeği ancak hiçbir depoda
    # değilken (git-kök çözülemiyorsa) ve tek aday varsa meşrudur.
    local kok; kok="$(git rev-parse --show-toplevel 2>/dev/null)"
    if [ -n "$kok" ]; then
      if [ -r "$kok/_agents/ANA-HEDEF.md" ]; then
        d="$kok/_agents/ANA-HEDEF.md"
      else
        # 🔴 ÜÇÜNCÜ AYNI DERS (2026-08-04): çapa main'de OLABİLİR ama bu çalışma-kopyası başka
        # dalda olduğu için dosya diskte GÖRÜNMEZ — merkez kutuda tam bu oldu, ekran hiç kuyruk
        # göstermedi. Kutunun hedefi bir DAL DEĞİL, deponun kendisidir → main'den okunur.
        # AĞA ÇIKMAZ (fetch YOK, yalnız yerel ref); `basla` her terminalde koşuyor, gecikme olamaz.
        local gecici
        gecici="${TMPDIR:-/tmp}/.kuyruk-$(id -u)-$(printf '%s' "$kok" | tr -c 'a-zA-Z0-9' '_')"
        if git -C "$kok" show origin/main:_agents/ANA-HEDEF.md > "$gecici" 2>/dev/null && [ -s "$gecici" ]; then
          d="$gecici"
        fi
      fi
    else
      local -a adaylar=()
      mapfile -t adaylar < <(ls -1 /config/projects/*/_agents/ANA-HEDEF.md 2>/dev/null)
      [ "${#adaylar[@]}" -eq 1 ] && d="${adaylar[0]}"
    fi
    # çapa yok: yalnız şablon teslim EDİLMİŞSE konuş (yoksa bu kutunun işi değil → sessiz)
    if [ -z "$d" ]; then
      local s=""
      if [ -n "$kok" ]; then
        [ -r "$kok/0-teslimat/gelen/ANA-HEDEF-SABLON.md" ] && s="$kok/0-teslimat/gelen/ANA-HEDEF-SABLON.md"
      else
        local -a sadaylar=()
        mapfile -t sadaylar < <(ls -1 /config/projects/*/0-teslimat/gelen/ANA-HEDEF-SABLON.md 2>/dev/null)
        [ "${#sadaylar[@]}" -eq 1 ] && s="${sadaylar[0]}"
      fi
      [ -n "$s" ] || return 0
      printf '\n  %s🎯 ana-hedefin yazılı değil%s — şablon geldi: %s%s%s\n' \
             "$C_SAR" "$C_SIF" "$C_SOL" "$s" "$C_SIF"
      printf '     %shedefini _agents/ANA-HEDEF.md olarak yaz (tazelik ≤7 gün — MÜDÜR sorumluluğu)%s\n' \
             "$C_SOL" "$C_SIF"
      return 0
    fi
  fi
  [ -r "$d" ] || return 0

  local n ilk damga bayat=""
  # NOT: `grep -c` eşleşme yokken "0" BASAR ve rc=1 döner; sonuna `|| echo 0` eklemek
  # çıktıyı "0\n0" yapar ve sayı karşılaştırması patlar (ilk koşumda yakalandı — G4).
  n="$(grep -cE '^[0-9]+\. ' "$d" 2>/dev/null)"; n="${n:-0}"
  ilk="$(grep -m1 -E '^[0-9]+\. ' "$d" 2>/dev/null | sed 's/^[0-9]*\. *//' | cut -c1-72)"
  damga="$(sed -n 's/^guncelleme: *\([0-9-]\{10\}\).*/\1/p' "$d" | head -1)"
  if [ -n "$damga" ]; then
    local e s2; e="$(date -d "$damga" +%s 2>/dev/null)"; s2="$(date +%s)"
    [ -n "$e" ] && [ $(( (s2 - e) / 86400 )) -gt 7 ] && bayat=" · damga $(( (s2 - e) / 86400 )) günlük (bayat)"
  fi

  if [ "${n:-0}" -eq 0 ]; then
    printf '\n  %s🎯 kuyruğun BOŞ%s%s — MÜDÜR'"'"'üne "kuyruk-boş" bildir %s(Sultan'"'"'a değil)%s\n' \
           "$C_SAR" "$C_SIF" "$bayat" "$C_SOL" "$C_SIF"
    return 0
  fi
  printf '\n  %s🎯 kuyruğunda %s iş var%s%s\n' "$C_BAS" "$n" "$C_SIF" "$bayat"
  printf '     • sıradaki: %s\n' "$ilk"
  printf '     %sŞ2-fiili (merge/prod/dış-servis/silme/sır) yoksa sorma — yürü; durmak ihlaldir%s\n' \
         "$C_SOL" "$C_SIF"
}

_yapistirma_nabzi() {
  [ -z "${BASLA_TEST_SECIM:-}" ] || return 0          # sınamalar ağa/porta bağlanmasın (hermetik)
  [ "${BASLA_YAPISTIRMA_KONTROL:-1}" = "1" ] || return 0
  command -v curl >/dev/null 2>&1 || return 0
  local kod
  kod="$(curl -s -o /dev/null -w '%{http_code}' --max-time 2 http://127.0.0.1:8391/health 2>/dev/null)"
  [ "$kod" = "200" ] && return 0                      # yaşıyor → sessiz kal
  local bas; bas="$(ls -1 /config/projects/*/.cc-images/imglistener-start.sh 2>/dev/null | head -1)"
  if [ -z "$bas" ]; then
    # Bu kutuda yapıştırma kurulumu hiç yok — arıza değil, yokluk. Sessiz geç.
    return 0
  fi
  if timeout 20 bash "$bas" >/dev/null 2>&1; then
    kod="$(curl -s -o /dev/null -w '%{http_code}' --max-time 2 http://127.0.0.1:8391/health 2>/dev/null)"
  fi
  if [ "$kod" = "200" ]; then
    printf '  %sresim yapıştırma yeniden başlatıldı (konteyner yenilenince duruyor)%s\n' "$C_SOL" "$C_SIF"
  else
    # Onaramadık → SUSMA. Sultan Cmd+V yapıp "500" görmeden önce bilsin.
    printf '  %s⚠ resim yapıştırma çalışmıyor%s — Cmd/Ctrl+V hata verir. Onarım: %sbash %s%s\n' \
           "$C_SAR" "$C_SIF" "$C_SOL" "$bas" "$C_SIF"
  fi
}

_ekran() {
  printf '\n'
  printf '  %s%s%s — çalışma ortamı\n' "$C_BAS" "$PROJE" "$C_SIF"
  if [ -n "$PANO" ] || [ -n "$KILAVUZ" ]; then
    printf '  %s' "$C_SOL"
    [ -n "$PANO" ]    && printf 'pano: %s' "$PANO"
    [ -n "$PANO" ] && [ -n "$KILAVUZ" ] && printf ' · '
    [ -n "$KILAVUZ" ] && printf 'kılavuz: %s' "$KILAVUZ"
    printf '%s\n' "$C_SIF"
  fi
  printf '\n'
  _kopya_satiri
  _ekip_blogu
  _kapimda_blogu
  _kuyruk_satiri
  _talep_zili
  _yapistirma_nabzi
  printf '  %sHazır%s — %sok tuşlarıyla seç, Enter ile onayla, ESC ile çık%s\n\n' \
         "$C_BAS" "$C_SIF" "$C_SOL" "$C_SIF"
}

# _gec — bir masaya GEÇ. tmux'un İÇİNDEN `attach` ÇALIŞMAZ:
#   "sessions should be nested with care, unset $TMUX to force"
# Sultan tam bunu gördü (2026-07-30, tez kutusu · durum çubuğu [tez-yon]): ekran üyeyi
# listeledi, seçimi aldı, sonra bu satırı basıp menüye geri attı → "geçemiyorum".
# tmux'un İÇİNDEYSEK doğru fiil `switch-client`; DIŞINDAYSAK `attach`.
_gec() {
  local h="$1"
  if [ -n "${TMUX:-}" ]; then
    if tmux switch-client -t "$h" 2>/dev/null; then
      # switch-client anında döner; ekranı zaten hedef masa kaplar.
      printf '  %s%s masasına geçildi%s\n' "$C_YSL" "$h" "$C_SIF"
    else
      printf '  %s✗ geçilemedi: %s%s\n' "$C_KRM" "$h" "$C_SIF"
      printf '  %selle:  tmux switch-client -t %s%s\n' "$C_SOL" "$h" "$C_SIF"
    fi
    return 0
  fi
  tmux attach -d -t "$h"
  printf '\n  %smasadan ayrıldın — menüye dönülüyor%s\n' "$C_SOL" "$C_SIF"
}

# _gecici_masalar — ekip listesinde OLMAYAN açık masalar (elle açılmış geçici seanslar).
# Sultan'ın isteği: "demirbaş ekip üyeleri sabit üstte, altta da geçici seanslar olsun
# (silik)". Eskiden bunlar hiç görünmüyordu → elle açtığı `ui` masası listede yoktu.
_gecici_masalar() {
  local ekip_hedefleri="$1"   # satır başına bir roster-hedefi (küçük harf)
  tmux ls -F '#{session_name}' 2>/dev/null | while read -r s; do
    [ -n "$s" ] || continue
    printf '%s\n' "$ekip_hedefleri" | grep -qix -- "$s" || printf '%s\n' "$s"
  done
}

# _ekip_onar — "Ekibi kontrol et / onar".
# ESKİ HÂL (Sultan canlı gördü, 2026-07-30 · tez kutusu): `ekip` aracı olmayan kutuda ham
# makine çıktısı ekrana dökülüyordu — sekmeyle ayrılmış, üye adı iki kez, sonunda
# "ÖZET 1 3 0". Sultan'a hiçbir şey anlatmıyordu, üstelik "onarım aracı yok, bu salt-bilgi"
# diyip ELİNDEN GELENİ de yapmıyordu: kapalı masayı açmak için `ekip` aracına gerek yok,
# `basla` bunu üye-geçişinde zaten yapıyor. Artık ölçümü Sultan-dilinde basar VE onarır.
_ekip_onar() {
  # Kutuda gerçek onarım aracı varsa O kanoniktir (Claude'u da başlatır) — davranış değişmez.
  if command -v ekip >/dev/null 2>&1; then ekip; printf '\n'; return 0; fi
  local ham rc
  ham="$(bash "$HERE/ekip-durum.sh" 2>/dev/null)"; rc=$?
  if [ "$rc" -eq 2 ]; then
    printf '  %sölçemedim%s (%s) — ekip listesi VAR, eksik olan ölçüm aracı.\n\n' \
           "$C_SAR" "$C_SIF" "$(printf '%s' "$ham" | head -1 | cut -f1)"
    return 0
  fi
  if [ "$rc" -ne 0 ]; then
    printf '  %sbu dizinde ekip tanımı yok — onarılacak ekip yok%s\n\n' "$C_SOL" "$C_SIF"
    return 0
  fi
  local -a kapali=() duplike=()
  local uid sess durum not ayakta=0
  while IFS=$'\t' read -r uid sess durum not; do
    [ -n "$uid" ] && [ "$uid" != "ÖZET" ] || continue
    case "$durum" in
      ayakta)  ayakta=$((ayakta+1)) ;;
      duplike) duplike+=("$sess") ;;
      *)       [ -n "$sess" ] && [ "$sess" != "-" ] && kapali+=("$sess") ;;
    esac
  done <<< "$ham"

  printf '  %s%s ayakta%s · %s kapalı' "$C_YSL" "$ayakta" "$C_SIF" "${#kapali[@]}"
  [ "${#duplike[@]}" -gt 0 ] && printf ' · %s%s duplike%s' "$C_SAR" "${#duplike[@]}" "$C_SIF"
  printf '\n'

  if [ "${#kapali[@]}" -eq 0 ] && [ "${#duplike[@]}" -eq 0 ]; then
    printf '  %sonarılacak bir şey yok%s\n\n' "$C_YSL" "$C_SIF"
    return 0
  fi
  [ "${#kapali[@]}" -gt 0 ]  && printf '  %skapalı:%s %s\n'  "$C_SOL" "$C_SIF" "${kapali[*]}"
  [ "${#duplike[@]}" -gt 0 ] && printf '  %sduplike:%s %s  %s(elle bakılmalı — hangisi gerçek, sen bilirsin)%s\n' \
                                       "$C_SAR" "$C_SIF" "${duplike[*]}" "$C_SOL" "$C_SIF"
  [ "${#kapali[@]}" -gt 0 ] || { printf '\n'; return 0; }

  printf '  %s masayı şimdi açayım mı? [E/h] ' "${#kapali[@]}"
  local c
  if [ -n "${BASLA_TEST_SECIM:-}" ]; then c="${BASLA_TEST_ONAY:-h}"; printf '%s\n' "$c"
  elif [ -r /dev/tty ]; then read -r c < /dev/tty || c="h"
  else c="h"; fi
  case "${c:-E}" in h|H|n|N) printf '  vazgeçildi.\n\n'; return 0 ;; esac

  local m acildi=0
  for m in "${kapali[@]}"; do
    if tmux new-session -d -s "$m" 2>/dev/null; then
      acildi=$((acildi+1)); printf '  %s✓%s %s\n' "$C_YSL" "$C_SIF" "$m"
    else
      printf '  %s✗%s %s açılamadı\n' "$C_KRM" "$C_SIF" "$m"
    fi
  done
  printf '  %s%s masa açıldı — içlerinde Claude başlatmak ayrı iş%s\n\n' "$C_SOL" "$acildi" "$C_SIF"
}

_uye_sec() {
  # ⚠️ ÖLÇÜM-HATASI ÜYE DEĞİLDİR. Eski hâl `ekip-durum.sh`in hata-jetonunu (EKIP-LISTESI-YOK)
  # bir üye sanıp "1 EKIP-LISTESI-YOK" diye listeliyordu (Sultan canlı testte gördü, 2026-07-30).
  # Çıkış-kodu ÖNCE kontrol edilir; jeton-satırları asla listeye girmez.
  local ham rc
  ham="$(bash "$HERE/ekip-durum.sh" 2>/dev/null)"; rc=$?
  # Ekip listesi okunamasa da GEÇİCİ masalar listelenir — "ekip tanımı yok" bir kutuda
  # da elle açılmış masalara geçmek istenebilir (Sultan: geçici seanslar da listede olsun).
  local out=""
  if [ "$rc" -eq 2 ]; then
    # dosya VAR, ölçüm aracı eksik → "ekip yok" DEMEYECEĞİZ (yalan olurdu)
    printf '  %sEkip listesini okuyamadım%s (%s) — ekip listesi VAR, eksik olan ölçüm aracı.\n' \
           "$C_SAR" "$C_SIF" "$(printf '%s' "$ham" | head -1 | cut -f1)"
    printf '  %sBunu ekran düzeltemez — kutunun kurulumunda eksik var, Sultana söyle.%s\n' "$C_SOL" "$C_SIF"
    printf '  %saşağıda yalnız geçici masalar var.%s\n\n' "$C_SOL" "$C_SIF"
  elif [ "$rc" -ne 0 ]; then
    printf '  %sBu dizinde ekip tanımı yok%s (%s) — aşağıda yalnız geçici masalar var.\n\n' \
           "$C_SAR" "$C_SIF" "$(printf '%s' "$ham" | head -1 | cut -f1)"
  else
    out="$(printf '%s\n' "$ham" | awk -F'\t' '$1!="ÖZET" && $1!="" && NF>=3{print}')"
  fi

  # ── liste: DEMİRBAŞ üstte sabit · GEÇİCİ altta silik (Sultan-kararı 2026-07-30) ──
  # Sıra ANLAM taşır: üstteki satırlar ekibin sabit kadrosu, alttakiler elle açılmış
  # geçici masalar. İkisi aynı numaralandırmada ama `hedefler` dizisi ayrımı korur.
  local -a satirlar=() hedefler=() tipler=()
  local i=0 uid sess durum not ekip_hedefleri=""
  if [ -n "$out" ]; then    # boş `out`ta while bir kez BOŞ satırla dönerdi → hayalî üye
    while IFS=$'\t' read -r uid sess durum not; do
      [ -n "$uid" ] || continue
      i=$((i+1))
      local isaret="○"; local renk="$C_SOL"
      case "$durum" in ayakta) isaret="●"; renk="$C_YSL" ;; duplike) isaret="⚠"; renk="$C_SAR" ;; esac
      satirlar+=("$(printf '%s  %s %-16s %s%s%s%s' "$i" "$isaret" "$uid" "$renk" "$durum" "$C_SIF" "${not:+  $not}")")
      hedefler+=("$sess"); tipler+=("demirbas")
    done <<< "$out"
    ekip_hedefleri="$(printf '%s\n' "$out" | awk -F'\t' '{print $2}')"
  fi

  local g
  while read -r g; do
    [ -n "$g" ] || continue
    i=$((i+1))
    satirlar+=("$(printf '%s  %s· %-15s %sgeçici%s' "$i" "$C_SOL" "$g" "$C_SOL" "$C_SIF")")
    hedefler+=("$g"); tipler+=("gecici")
  done <<< "$(_gecici_masalar "$ekip_hedefleri")"

  if [ "${#hedefler[@]}" -eq 0 ]; then
    printf '  %sgeçilecek masa yok — ne ekip listesi ne açık bir masa var%s\n\n' "$C_SOL" "$C_SIF"
    return 0
  fi
  local s; s="$(_sec 'Hangi masa?  (üstte ekip · altta geçici · ESC = geri)' "${satirlar[@]}")"
  [ -n "$s" ] || return 0
  case "$s" in ''|*[!0-9]*) printf '  (anlamadım)\n'; return 0 ;; esac
  [ "$s" -ge 1 ] && [ "$s" -le "${#hedefler[@]}" ] || { printf '  (listede yok: %s)\n' "$s"; return 0; }
  local hedef="${hedefler[$((s-1))]}" tip="${tipler[$((s-1))]}"
  # ekip-durum.sh masası tanımsız üye için `-` basar; onu masa adı sanmayalım
  if [ -z "$hedef" ] || [ "$hedef" = "-" ]; then
    printf '  %sbu üyenin ekip listesinde masa adı yok — geçilecek yer yok%s\n\n' "$C_SAR" "$C_SIF"
    return 0
  fi
  if tmux has-session -t "$hedef" 2>/dev/null; then
    # `exec` KULLANMA: süreci değiştirir → masadan ayrılınca (detach) menüye DÖNÜLEMEZ,
    # kabuğa düşülür. Sultan'ın açık isteği "geri dönmek yok" idi; attach'tan sonra da geçerli.
    _gec "$hedef"
    return 0
  fi
  if [ "$tip" = "gecici" ]; then
    # Geçici masa listelendiği anda vardı, şimdi yok → aradaki saniyelerde kapanmış.
    printf '  %s%s masası artık yok (geçici masa kapanmış)%s\n\n' "$C_SAR" "$hedef" "$C_SIF"
    return 0
  fi
  # Kapalı üye seçilince ESKİDEN yalnız "1'e bas" derdi ve menü hemen üstüne çizilirdi →
  # Sultan'ın gözünde "hiçbir şey olmuyor, aynı ekrana geri şutlanıyorum". Artık BURADA
  # ayağa kaldırmayı teklif ediyor; iş yapılan yerde yapılıyor.
  printf '  %s%s kapalı.%s\n' "$C_SAR" "$hedef" "$C_SIF"
  printf '  Şimdi ayağa kaldırayım mı? [E/h] '
  local c
  if [ -n "${BASLA_TEST_SECIM:-}" ]; then c="${BASLA_TEST_ONAY:-h}"; printf '%s\n' "$c"
  elif [ -r /dev/tty ]; then read -r c < /dev/tty || c="h"
  else c="h"; fi
  case "${c:-E}" in
    h|H|n|N) printf '  vazgeçildi.\n\n'; return 0 ;;
  esac
  if command -v ekip >/dev/null 2>&1; then
    ekip
  else
    tmux new-session -d -s "$hedef" 2>/dev/null \
      && printf '  %s✓ masa açıldı: %s%s (içinde Claude başlatmak sana kaldı — ekip aracı bu kutuda yok)\n' "$C_YSL" "$hedef" "$C_SIF" \
      || printf '  %s✗ masa açılamadı: %s%s\n' "$C_KRM" "$hedef" "$C_SIF"
  fi
  printf '\n'
  if tmux has-session -t "$hedef" 2>/dev/null; then
    printf '  %s%s artık ayakta — geçiliyor%s\n' "$C_YSL" "$hedef" "$C_SIF"
    _gec "$hedef"
  fi
}

# TTY yoksa (betik/otomasyon): yalnız çiz, seçim sorma.
_ekran

# TTY yok VE test-kancası da yoksa: yalnız çizdi, çıkıyor. (Kanca TTY-kapısını AŞAR ki
# etkileşimli akış sınanabilsin; kanca set edilmedikçe davranış hiç değişmez.)
[ -t 0 ] || [ -n "${BASLA_TEST_SECIM:-}" ] || exit 0

_eylem() {
  case "${1:-}" in
    1) _ekip_onar ;;
    2) _uye_sec ;;
    3) if command -v yenisession >/dev/null 2>&1; then yenisession; else printf '  yenisession bulunamadı\n'; fi; printf '\n' ;;
    4) if command -v yardim >/dev/null 2>&1; then yardim; else printf '  yardim bulunamadı\n'; fi; printf '\n' ;;
    5) if command -v cs >/dev/null 2>&1; then cs ls; else printf '  cs bulunamadı\n'; fi; printf '\n' ;;
    q|Q|cik|çık) return 9 ;;
    "") return 9 ;;
    *) printf '  (anlamadım — %s1-5%s, Enter ya da q)\n\n' "$C_VUR" "$C_SIF" ;;
  esac
  return 0
}

# ── TEST SEAM (yalnız sınama) ────────────────────────────────────────────────
# NİÇİN VAR: bu ekran etkileşimlidir; TTY olmadan seçim akışı KOŞULAMAZ ve bu yüzden
# 2026-07-30'da iki kez üst üste kırıldı (symlink-yolu · hata-jetonunu üye sanma) —
# ikisi de yalnız Sultan canlı denerken görüldü. Kanca, seçim akışının testlenebilmesi
# içindir; ÜRETİMDE ETKİSİZDİR (değişken set edilmedikçe hiçbir şey değişmez).
# Tek seçim uygular, çıkar; döngüye girmez.
if [ -n "${BASLA_TEST_SECIM:-}" ]; then
  secim="$BASLA_TEST_SECIM"
  _eylem "$secim"
  exit 0
fi

# ── ETKILESIMLI DONGU (tek otorite: _eylem) ──────────────────────────────────
# Menü de ok-tuşlu: Sultan okları ANA MENÜde denedi ve ekrana kaçış-kodu bastı.
_menu_satirlari() {
  local a b
  if [ "${EKIP_YOK:-0}" -eq 1 ]; then a="(bu dizinde ekip yok)"; b="yalnız geçici masalar"
  else a="süz → eksikleri kaldır → duplike temizle"; b="ekip üstte · geçici masalar altta"; fi
  printf '%s\n' \
    "1  Ekibi kontrol et / onar          $a" \
    "2  Bir masaya geç                   $b" \
    "3  Yeni sohbet başlat               adını sorar" \
    "4  Kuralları ve komutları göster" \
    "5  Eski sohbetlerde ara             tüm liste — kalabalıktır" \
    "q  Çık"
}
while :; do
  mapfile -t _MS < <(_menu_satirlari)
  secim="$(_sec 'Ne yapmak istersin?  (ok tuşlarıyla seç · Enter · ESC = çık)' "${_MS[@]}")"
  printf '\n'
  [ -z "${secim:-}" ] && exit 0
  _eylem "${secim}" ; rc=$?
  [ "$rc" -eq 9 ] && exit 0
  # ⚠️ MESAJ YUTULMASIN: eskiden menü hemen yeniden çiziliyordu ve eylemin bastığı satır
  # (ör. "X kapalı") ekranın yukarısına kaçıp kayboluyordu → "hiçbir şey olmuyor" hissi.
  if [ -r /dev/tty ] && [ -z "${BASLA_TEST_SECIM:-}" ]; then
    printf '  %sdevam için Enter%s' "$C_SOL" "$C_SIF"
    read -r _ < /dev/tty || true
    printf '\n'
  fi
  _ekran   # ← GERİYE DÖNÜŞ: her eylemden sonra menü yeniden gelir
done
