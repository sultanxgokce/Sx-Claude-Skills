#!/usr/bin/env bash
# basla — kutuda terminal açılınca gelen KARŞILAMA EKRANI.
#
# NİÇİN VAR (2026-07-30, Sultan): terminal açılır açılmaz `cs` seans-seçici geliyordu.
# "Kafa karışıyor; yenisession yazması gerektiğini kimse bilmiyor." Seans listesi, ne
# yapacağını ZATEN bilen birine göre bir ekran — yeni gelen için değil.
#
# v2 (Sultan geri-bildirimi, aynı gün):
#   · "seçim yaptıktan sonra geriye dönmek yok"      → her eylemden sonra menüye DÖNER
#   · "2'yi seçince karmaşık bir cümbüşe düşüyorum"  → ekip ÜSTTE sabit; 103-satırlık
#      filo listesi menüden kalktı, yalnız 'ara' seçeneğinin arkasında
#   · "ekip demirbaş, üstte sabit olmalı"            → Ekibim bloğu roster'dan gelir
#   · "tek tuşla kontrol: ayakta mı, duplike var mı" → seçenek 1 (ölç → göster → onar-öner)
#   · kutu adı artık SABİT DEĞİL — roster/dizinden türetilir ("Huzur" her kutuda yazıyordu)
#
# Sözleşme: hiçbir şey ZORLAMAZ. Enter → düz terminal. TTY yoksa yalnız yazar ve çıkar.
# ÖLÇÜM ≠ İDDİA: ekip satırı ekip-durum.sh'ten gelir; ölçülemezse "ölçülemedi" der,
# "her şey yolunda" DEMEZ.
set -u

# ⚠️ SYMLINK-FARKINDA yol çözümü. Bu betik PATH'ten (~/.local/bin/basla → symlink) çağrılır;
# çıplak dirname o zaman /config/.local/bin verir ve yanındaki ekip-durum.sh'i BULAMAZ
# (firsthand 2026-07-30: ekran "ölçülemedi" dedi, oysa ölçüm betiği tek başına çalışıyordu).
# Doğrudan koşumda test edip PATH koşumunda kırılan sınıf — "birim yeşil ≠ yol çalışıyor".
_KAYNAK="${BASH_SOURCE[0]}"
while [ -L "$_KAYNAK" ]; do
  _HEDEF="$(readlink "$_KAYNAK")"
  case "$_HEDEF" in /*) _KAYNAK="$_HEDEF" ;; *) _KAYNAK="$(dirname "$_KAYNAK")/$_HEDEF" ;; esac
done
HERE=$(cd "$(dirname "$_KAYNAK")" && pwd)
PROJE="${BASLA_PROJE:-$(basename "${PWD:-/}")}"
[ "$PROJE" = "/" ] && PROJE="çalışma alanı"
EKIP_YOK=0
PANO="${BASLA_PANO:-}"
KILAVUZ="${BASLA_KILAVUZ:-}"

if [ -t 1 ]; then
  C_BAS=$'\033[1m'; C_SOL=$'\033[2m'; C_VUR=$'\033[36m'; C_YSL=$'\033[32m'; C_KRM=$'\033[31m'; C_SAR=$'\033[33m'; C_SIF=$'\033[0m'
else
  C_BAS=""; C_SOL=""; C_VUR=""; C_YSL=""; C_KRM=""; C_SAR=""; C_SIF=""
fi

# ── OK-TUŞLU SEÇİCİ ──────────────────────────────────────────────────────────
# NİÇİN (Sultan, 2026-07-30 canlı test): çıplak `read` ok-tuşlarını harf sanıyor ve ekrana
# `^[[B^[[A` basıyordu ("saçma saçma karakterler"). fzf bu kutuda ZATEN kurulu ve `cs` de
# onu kullanıyor — yeni bağımlılık yok, tutarlı davranış var.
# Sözleşme: fzf varsa ok+Enter (yazarak da süzülür); yoksa numara-okuma yedeği.
# Çıktı: seçilen satırın İLK jetonu (menü numarası ya da üye sırası). ESC/iptal → boş.
_sec() {  # _sec "<baslik>" <satir...>
  local baslik="$1"; shift
  if [ -n "${BASLA_TEST_SECIM:-}" ]; then printf '%s\n' "${BASLA_TEST_UYE:-}"; return 0; fi
  # ⚠️ `[ -t 1 ]` KULLANMA: _sec her zaman $(...) içinde çağrılır, orada stdout BİR BORUDUR,
  # terminal değil → kapı hep kapalı kalır, fzf hiç açılmaz ve yedek yol menüyü DEĞİŞKENE yazar
  # (kullanıcı hiçbir şey görmez, okları read'e gider → ekrana ^[[B basar).
  # Firsthand: Sultan 2026-07-30, iki ayrı ekran görüntüsü. Doğru kapı: /dev/tty erişilebilir mi.
  if command -v fzf >/dev/null 2>&1 && [ -r /dev/tty ] && [ -w /dev/tty ]; then
    printf '%s\n' "$@" | fzf --ansi --no-multi --height=~60% --reverse --border=none \
        --prompt='› ' --header="$baslik" --info=inline \
        --bind='esc:abort' | awk '{print $1}'
    # NOT: fzf'e `< /dev/tty` VERİLMEZ — stdin aday-listesidir (boru). /dev/tty'ye yönlendirmek
    # listeyi EZER ve fzf boş listeyle açılır. Klavyeyi fzf kendisi /dev/tty'den okur.
    return 0
  fi
  # yedek: numara-okuma. UI /dev/tty'ye yazılır (stdout DÖNÜŞ-DEĞERİdir, kirletilemez).
  if [ -w /dev/tty ]; then
    printf '%s\n' "$@"        > /dev/tty
    printf '\n  Seçimin (numara): ' > /dev/tty
    local s; read -r s < /dev/tty || s=""
    printf '\n' > /dev/tty
    printf '%s\n' "$s" | awk '{print $1}'
  else
    # ne fzf ne tty → seçim sorulamaz (betik/otomasyon): boş dön, çağıran çıkar.
    printf '\n'
  fi
}

_ekip_blogu() {
  local out rc
  out="$(bash "$HERE/ekip-durum.sh" 2>/dev/null)"; rc=$?
  if [ "$rc" -ne 0 ] || [ -z "$out" ]; then
    printf '  %sEkibim%s\n' "$C_BAS" "$C_SIF"
    printf '  %sbu dizinde ekip tanımı yok%s\n' "$C_SOL" "$C_SIF"
    # Yol göster: hangi alt dizinlerde ekip tanımı VAR? (üst dizinde durunca en sık hâl)
    local bulunan="" d
    for d in */ ; do
      [ -d "$d" ] || continue
      if [ -f "${d}_agents/handoff/aile-registry.yaml" ] || [ -f "${d}_agents/ekip-os/ekip-registry.yaml" ] \
         || [ -f "${d}_agents/handoff/ekip-registry.yaml" ]; then
        bulunan="$bulunan ${d%/}"
      fi
    done
    if [ -n "$bulunan" ]; then
      printf '  %sekip tanımı olan projeler:%s%s\n' "$C_SOL" "$bulunan" "$C_SIF"
      printf '  %sör:  cd %s && basla%s\n\n' "$C_SOL" "$(printf '%s' "$bulunan" | awk '{print $1}')" "$C_SIF"
    else
      printf '  %s(tek kişilik kutu olabilir — bu bir arıza değil)%s\n\n' "$C_SOL" "$C_SIF"
    fi
    EKIP_YOK=1
    return 0
  fi
  local ozet; ozet="$(printf '%s\n' "$out" | awk -F'\t' '$1=="ÖZET"{print $2" "$3" "$4}')"
  set -- $ozet; local a="${1:-0}" k="${2:-0}" d="${3:-0}"
  printf '  %sEkibim%s  %s(demirbaş — sabit)%s\n' "$C_BAS" "$C_SIF" "$C_SOL" "$C_SIF"
  printf '%s\n' "$out" | awk -F'\t' -v ys="$C_YSL" -v sr="$C_SAR" -v sf="$C_SIF" -v sl="$C_SOL" '
    # gorunur-genislik: UTF-8 devam-baytlari (0x80-0xBF) sayilmaz — Turkce harfler sutunu kaydirmasin
    function gw(s){ t=s; gsub(/[\200-\277]/,"",t); return length(t) }
    function pad(s,w){ n=w-gw(s); r=""; while(n-->0) r=r" "; return s r }
    $1=="ÖZET" || $1=="" {next}
    {
      ad=pad($1,15);
      if ($3=="ayakta")       printf "   %s●%s %s %sayakta%s\n",  ys, sf, ad, ys, sf;
      else if ($3=="duplike") printf "   %s⚠%s %s %s%s%s\n",      sr, sf, ad, sr, $4, sf;
      else                    printf "   %s○%s %s %skapalı%s\n",  sl, sf, ad, sl, sf;
    }'
  printf '\n   %s%s ayakta · %s kapalı%s' "$C_SOL" "$a" "$k" "$C_SIF"
  [ "$d" -gt 0 ] && printf '%s · %s duplike%s' "$C_SAR" "$d" "$C_SIF"
  printf '\n'
  printf '   %smasa ≠ sohbet: masa açık olsa da içinde Claude çalışmıyor olabilir%s\n\n' "$C_SOL" "$C_SIF"
}

_ekran() {
  printf '\n'
  printf '  %s%s%s — çalışma ortamı\n' "$C_BAS" "$PROJE" "$C_SIF"
  if [ -n "$PANO" ] || [ -n "$KILAVUZ" ]; then
    printf '  %s' "$C_SOL"
    [ -n "$PANO" ]    && printf 'pano: %s' "$PANO"
    [ -n "$PANO" ] && [ -n "$KILAVUZ" ] && printf ' · '
    [ -n "$KILAVUZ" ] && printf 'kılavuz: %s' "$KILAVUZ"
    printf '%s\n' "$C_SIF"
  fi
  printf '\n'
  _ekip_blogu
  printf '  %sHazır%s — %sok tuşlarıyla seç, Enter ile onayla, ESC ile çık%s\n\n' \
         "$C_BAS" "$C_SIF" "$C_SOL" "$C_SIF"
}

_uye_sec() {
  # ⚠️ ÖLÇÜM-HATASI ÜYE DEĞİLDİR. Eski hâl `ekip-durum.sh`in hata-jetonunu (EKIP-LISTESI-YOK)
  # bir üye sanıp "1 EKIP-LISTESI-YOK" diye listeliyordu (Sultan canlı testte gördü, 2026-07-30).
  # Çıkış-kodu ÖNCE kontrol edilir; jeton-satırları asla listeye girmez.
  local ham rc
  ham="$(bash "$HERE/ekip-durum.sh" 2>/dev/null)"; rc=$?
  if [ "$rc" -ne 0 ]; then
    printf '  %sEkip listesi okunamadı%s (%s) — bu dizinde ekip tanımı yok.\n' "$C_SAR" "$C_SIF" "$(printf '%s' "$ham" | head -1)"
    printf '  %sBir proje dizinine geç, örn:  cd ~/projects/Nexus && basla%s\n\n' "$C_SOL" "$C_SIF"
    return 0
  fi
  local out; out="$(printf '%s\n' "$ham" | awk -F'\t' '$1!="ÖZET" && $1!="" && NF>=3{print}')"
  [ -n "$out" ] || { printf '  ekip listesi boş — geri dönülüyor\n\n'; return 0; }
  local -a satirlar=(); local i=0
  while IFS=$'\t' read -r uid sess durum not; do
    i=$((i+1)); satirlar+=("$(printf '%s  %-16s %s%s' "$i" "$uid" "$durum" "${not:+  $not}")")
  done <<< "$out"
  local s; s="$(_sec 'Hangi üye?  (ok tuşlarıyla seç · Enter · ESC = geri)' "${satirlar[@]}")"
  [ -n "$s" ] || return 0
  local hedef; hedef="$(printf '%s\n' "$out" | awk -F'\t' -v n="$s" 'NR==n{print $2}')"
  [ -n "$hedef" ] || { printf '  (anlamadım)\n'; return 0; }
  if tmux has-session -t "$hedef" 2>/dev/null; then
    # `exec` KULLANMA: süreci değiştirir → masadan ayrılınca (detach) menüye DÖNÜLEMEZ,
    # kabuğa düşülür. Sultan'ın açık isteği "geri dönmek yok" idi; attach'tan sonra da geçerli.
    tmux attach -t "$hedef"
    printf '\n  %smasadan ayrıldın — menüye dönülüyor%s\n' "$C_SOL" "$C_SIF"
    return 0
  fi
  # Kapalı üye seçilince ESKİDEN yalnız "1'e bas" derdi ve menü hemen üstüne çizilirdi →
  # Sultan'ın gözünde "hiçbir şey olmuyor, aynı ekrana geri şutlanıyorum". Artık BURADA
  # ayağa kaldırmayı teklif ediyor; iş yapılan yerde yapılıyor.
  printf '  %s%s kapalı.%s\n' "$C_SAR" "$hedef" "$C_SIF"
  printf '  Şimdi ayağa kaldırayım mı? [E/h] '
  local c
  if [ -n "${BASLA_TEST_SECIM:-}" ]; then c="${BASLA_TEST_ONAY:-h}"; printf '%s\n' "$c"
  elif [ -r /dev/tty ]; then read -r c < /dev/tty || c="h"
  else c="h"; fi
  case "${c:-E}" in
    h|H|n|N) printf '  vazgeçildi.\n\n'; return 0 ;;
  esac
  if command -v ekip >/dev/null 2>&1; then
    ekip
  else
    tmux new-session -d -s "$hedef" 2>/dev/null \
      && printf '  %s✓ masa açıldı: %s%s (içinde Claude başlatmak sana kaldı — ekip aracı bu kutuda yok)\n' "$C_YSL" "$hedef" "$C_SIF" \
      || printf '  %s✗ masa açılamadı: %s%s\n' "$C_KRM" "$hedef" "$C_SIF"
  fi
  printf '\n'
  if tmux has-session -t "$hedef" 2>/dev/null; then
    printf '  %s%s artık ayakta — geçiliyor%s\n' "$C_YSL" "$hedef" "$C_SIF"
    tmux attach -t "$hedef"
    printf '\n  %smasadan ayrıldın — menüye dönülüyor%s\n' "$C_SOL" "$C_SIF"
  fi
}

# TTY yoksa (betik/otomasyon): yalnız çiz, seçim sorma.
_ekran

# TTY yok VE test-kancası da yoksa: yalnız çizdi, çıkıyor. (Kanca TTY-kapısını AŞAR ki
# etkileşimli akış sınanabilsin; kanca set edilmedikçe davranış hiç değişmez.)
[ -t 0 ] || [ -n "${BASLA_TEST_SECIM:-}" ] || exit 0

_eylem() {
  case "${1:-}" in
    1) if command -v ekip >/dev/null 2>&1; then ekip; else
         bash "$HERE/ekip-durum.sh" | sed 's/^/  /'
         printf '\n  %sonarım aracı (ekip) bu kutuda yok — yukarıdaki ölçüm salt-bilgidir%s\n' "$C_SOL" "$C_SIF"
       fi; printf '\n' ;;
    2) _uye_sec ;;
    3) if command -v yenisession >/dev/null 2>&1; then yenisession; else printf '  yenisession bulunamadı\n'; fi; printf '\n' ;;
    4) if command -v yardim >/dev/null 2>&1; then yardim; else printf '  yardim bulunamadı\n'; fi; printf '\n' ;;
    5) if command -v cs >/dev/null 2>&1; then cs ls; else printf '  cs bulunamadı\n'; fi; printf '\n' ;;
    q|Q|cik|çık) return 9 ;;
    "") return 9 ;;
    *) printf '  (anlamadım — %s1-5%s, Enter ya da q)\n\n' "$C_VUR" "$C_SIF" ;;
  esac
  return 0
}

# ── TEST SEAM (yalnız sınama) ────────────────────────────────────────────────
# NİÇİN VAR: bu ekran etkileşimlidir; TTY olmadan seçim akışı KOŞULAMAZ ve bu yüzden
# 2026-07-30'da iki kez üst üste kırıldı (symlink-yolu · hata-jetonunu üye sanma) —
# ikisi de yalnız Sultan canlı denerken görüldü. Kanca, seçim akışının testlenebilmesi
# içindir; ÜRETİMDE ETKİSİZDİR (değişken set edilmedikçe hiçbir şey değişmez).
# Tek seçim uygular, çıkar; döngüye girmez.
if [ -n "${BASLA_TEST_SECIM:-}" ]; then
  secim="$BASLA_TEST_SECIM"
  _eylem "$secim"
  exit 0
fi

# ── ETKILESIMLI DONGU (tek otorite: _eylem) ──────────────────────────────────
# Menü de ok-tuşlu: Sultan okları ANA MENÜde denedi ve ekrana kaçış-kodu bastı.
_menu_satirlari() {
  local a b
  if [ "${EKIP_YOK:-0}" -eq 1 ]; then a="(bu dizinde ekip yok)"; b="(bu dizinde ekip yok)"
  else a="süz → eksikleri kaldır → duplike temizle"; b=""; fi
  printf '%s\n' \
    "1  Ekibi kontrol et / onar          $a" \
    "2  Bir ekip üyesine geç             $b" \
    "3  Yeni sohbet başlat               adını sorar" \
    "4  Kuralları ve komutları göster" \
    "5  Eski sohbetlerde ara             tüm liste — kalabalıktır" \
    "q  Çık"
}
while :; do
  mapfile -t _MS < <(_menu_satirlari)
  secim="$(_sec 'Ne yapmak istersin?  (ok tuşlarıyla seç · Enter · ESC = çık)' "${_MS[@]}")"
  printf '\n'
  [ -z "${secim:-}" ] && exit 0
  _eylem "${secim}" ; rc=$?
  [ "$rc" -eq 9 ] && exit 0
  # ⚠️ MESAJ YUTULMASIN: eskiden menü hemen yeniden çiziliyordu ve eylemin bastığı satır
  # (ör. "X kapalı") ekranın yukarısına kaçıp kayboluyordu → "hiçbir şey olmuyor" hissi.
  if [ -r /dev/tty ] && [ -z "${BASLA_TEST_SECIM:-}" ]; then
    printf '  %sdevam için Enter%s' "$C_SOL" "$C_SIF"
    read -r _ < /dev/tty || true
    printf '\n'
  fi
  _ekran   # ← GERİYE DÖNÜŞ: her eylemden sonra menü yeniden gelir
done
