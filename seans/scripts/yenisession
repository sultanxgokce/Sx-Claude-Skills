#!/usr/bin/env bash
# yenisession — yeni bir Claude sohbeti aç; istersen ekranı bölüp YANDA açar.
#
# Kullanım:
#   yenisession                  → adını sorar, bu pencerede açar
#   yenisession "randevu ekrani" → adı verilmiş, bu pencerede açar
#   yenisession --yan            → adını sorar, ekranı böler, YANDA açar
#   yenisession --yan "test"     → adı verilmiş, yanda açar
#
# NİÇİN AD SORAR: adsız seans üç gün sonra "(isimsiz)" olur ve hangisi olduğu bilinmez;
#   sessiongetir listesinde de bulunamaz. Ad, seansın tek tutamağıdır.
#   Boş bırakırsan yine açılır — zorlamıyoruz, sadece hatırlatıyoruz.
set -uo pipefail

# Sembolik bağdan çağrılabilir: kutularda bu betik PATH'e symlink olarak konuyor
# (kopya bırakmak bayatlar — huzur kutusunda 2026-07-30'da tam bu yüzden eski cs koştu).
# Bu yüzden ÖNCE bağı çöz, sonra dizini al; yoksa kardeş cs.sh bulunamaz.
__kaynak="${BASH_SOURCE[0]}"
while [ -L "$__kaynak" ]; do
  __hedef="$(readlink "$__kaynak")"
  case "$__hedef" in /*) __kaynak="$__hedef" ;; *) __kaynak="$(dirname "$__kaynak")/$__hedef" ;; esac
done
BURASI="$(cd "$(dirname "$__kaynak")" && pwd)"
CS="${SEANS_CS:-$BURASI/cs.sh}"
[ -f "$CS" ] || { echo "HATA: seans yöneticisi bulunamadı: $CS" >&2; exit 2; }

YAN=0; AD=""
while [ $# -gt 0 ]; do
  case "$1" in
    --yan|-y) YAN=1; shift ;;
    -h|--yardim) sed -n '2,16p' "$0"; exit 0 ;;
    *) AD="$1"; shift ;;
  esac
done

if [ -z "$AD" ]; then
  # Etkileşimli olmayan ortamda (script/cron) soru sorma — sessizce adsız devam et.
  if [ -t 0 ]; then
    printf 'Bu sohbetin adı ne olsun? (boş bırakabilirsin): '
    read -r AD || AD=""
  fi
fi

if [ "$YAN" = "1" ]; then
  if [ -z "${TMUX:-}" ]; then
    # DÜRÜSTLÜK: tmux dışındayken ekran bölünemez. Sessizce "yanda açtım" DEME.
    echo "⚠ Ekranı bölemiyorum: tmux oturumunda değilsin. Bu pencerede açıyorum." >&2
    YAN=0
  fi
fi

if [ "$YAN" = "1" ]; then
  tmux split-window -h "bash '$CS' new; bash -l" || {
    echo "HATA: ekran bölünemedi." >&2; exit 1; }
  # Yanda açılan seansta ad, doğduktan sonra verilir (o pencerenin içinden). Tek fark:
  # kullanıcıya iş yükleyip bırakmıyoruz — komut hazır, kopyalanabilir.
  [ -n "$AD" ] && echo "🟢 Yanda yeni sohbet açıldı. Adını koymak için orada: cs rename current \"$AD\""
  [ -z "$AD" ] && echo "🟢 Yanda yeni sohbet açıldı."
  exit 0
fi

# AD'ı MOTORA GEÇİR. Eskiden burada yalnız "açıldıktan sonra şunu çalıştır" diye bir satır
# basılırdı; Claude açılınca o satır ekrandan kayboluyor ve kullanıcının yazdığı ad hiçbir
# yere gitmiyordu (firsthand 2026-07-30, Sultan: "adımı sultan yazdım ama hiçbir şey sultan
# olmadı"). Artık ad doğumda pencereye/sekmeye yazılıyor → alt çubukta sürekli görünüyor.
if [ -n "$AD" ]; then
  exec bash "$CS" new --ad "$AD"
fi
exec bash "$CS" new
